/dts-v1/;

#include <espressif/esp32p4/esp32p4_n32r32.dtsi>
#include "esp32p4_wifi6_touch_lcd_5_esp32p4_hpcore-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <espressif/partitions_0x2000_default_32M.dtsi>

/ {
	model = "ESP32-P4-WIFI6-Touch-LCD-5 HP Core";
	compatible = "espressif,esp32p4";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &dsi_display;
		zephyr,touch = &gt911;
		zephyr,bt-hci = &esp_hosted_mcu_hci;
	};

	aliases {
		sdhc0 = &sdhc0;
		sw0 = &boot_button;
		watchdog0 = &wdt0;
		pwm-led0 = &lcd_backlight;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button {
			label = "Boot Button";
			gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		/* The AP3032 LED driver is dimmed from the averaged PWM level, so
		 * the panel stays dark if GPIO26 is only held at a static level.
		 */
		lcd_backlight: lcd_backlight {
			label = "LCD Backlight";
			pwms = <&ledc0 0 PWM_HZ(5000) PWM_POLARITY_NORMAL>;
		};
	};

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&gt911>;
	};
};

/* Pre-v3 (v1.3) silicon: valid CPU frequencies are 90/180/360 MHz */
&cpu0 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&cpu1 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	gt911: touch-controller@5d {
		compatible = "goodix,gt911";
		status = "okay";
		reg = <0x5d>;
		/* TP_RST reaches GPIO23 through R37, but TP_INT only reaches
		 * GPIO2 when the optional R108 is populated. The INT level at
		 * reset is therefore not ours to choose, so the address the
		 * controller latched is probed instead of being forced. GPIO2
		 * is also on the 40-pin header: nothing else may drive it.
		 */
		reset-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
		irq-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		alt-addr = <0x14>;
		screen-width = <720>;
		screen-height = <1280>;
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&mipi_dsi {
	status = "okay";
	/* Panel rate is 2 lanes x 700 Mbit/s. The DPI clock is divided down
	 * from a fixed 240 MHz, so the 58 MHz the vendor driver asks for is
	 * actually driven at 60 MHz.
	 */
	phy-clock = <700000000>;
	dpi-clock-frequency = <58000000>;

	hx8394: panel-controller@0 {
		compatible = "waveshare,hx8394";
		reg = <0>;
		data-lanes = <2>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB565>;
		width = <720>;
		height = <1280>;
		/* The panel resets on a high level, not the usual low one. */
		reset-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;

		display-timings {
			compatible = "zephyr,panel-timing";
			hsync-len = <20>;
			hback-porch = <20>;
			hfront-porch = <40>;
			vsync-len = <4>;
			vback-porch = <10>;
			vfront-porch = <24>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
	};
};

&dsi_display {
	status = "okay";
	pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
	width = <720>;
	height = <1280>;
};

&i2s0 {
	status = "disabled";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";
};

&spi2 {
	status = "disabled";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&dma_axi {
	status = "okay";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};

&sdhc {
	sdhc0: sdhc@0 {
		status = "okay";
		bus-width = <4>;
		max-bus-freq = <40000000>;
		/* GPIO45: SD card power enable (active-low) */
		pwr-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
		clk-pin = <43>;
		cmd-pin = <44>;
		d0-pin = <39>;
		d1-pin = <40>;
		d2-pin = <41>;
		d3-pin = <42>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};

	/* ESP32-C6-MINI-1 running esp-hosted-mcu firmware. GPIO14..GPIO19 carry
	 * the SDIO link and GPIO54 drives C6_CHIP_PU.
	 */
	sdhc1: sdhc@1 {
		status = "okay";
		bus-width = <4>;
		max-bus-freq = <40000000>;
		clk-pin = <18>;
		cmd-pin = <19>;
		d0-pin = <14>;
		d1-pin = <15>;
		d2-pin = <16>;
		d3-pin = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		esp_hosted_mcu: esp-hosted-mcu@0 {
			compatible = "espressif,esp-hosted-mcu";
			reg = <0>;
			reset-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
			status = "okay";

			esp_hosted_mcu_wifi: wifi {
				compatible = "espressif,esp-hosted-mcu-wifi";
				status = "okay";
			};

			esp_hosted_mcu_hci: bt-hci {
				compatible = "espressif,esp-hosted-mcu-bt-hci";
				status = "okay";
			};
		};
	};
};

&ldo {
	status = "okay";

	ldo1@1 {
		reg = <1>;
		regulator-name = "ldo1";
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo2@2 {
		reg = <2>;
		regulator-name = "ldo2";
		regulator-init-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* LDO_VO3 supplies VDD_MIPI_DPHY; the D-PHY stays powered down
	 * without it and the panel never receives anything.
	 */
	ldo3@3 {
		reg = <3>;
		regulator-name = "ldo3";
		regulator-init-microvolt = <2500000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo4@4 {
		reg = <4>;
		regulator-name = "ldo4";
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};
