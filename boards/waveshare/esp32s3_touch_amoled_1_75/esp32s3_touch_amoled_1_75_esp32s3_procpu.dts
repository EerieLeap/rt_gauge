/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include "esp32s3_touch_amoled_1_75-pinctrl.dtsi"
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <espressif/partitions_0x0_amp_16M.dtsi>

/ {
	model = "ESP32-S3-Touch-AMOLED-1.75 PROCPU";
	compatible = "waveshare,esp32-s3-touch-amoled-1.75";

	aliases {
		i2c-1 = &i2c1;
		sw0 = &button0;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &co5300_display;
		zephyr,touch = &cst92xx;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	/* Buttons */
	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	mspi2: mspi2@60024000 {
		status = "okay";
		compatible = "espressif,esp32-mspi";
		reg = <0x60024000 DT_SIZE_K(4)>;
		#address-cells = <1>;
		#size-cells = <0>;

		peripheral-id = <0>; /* SPI2: peripheral_id=0, host_id=1 */
		clocks = <&clock ESP32_SPI2_MODULE>;
		interrupts = <SPI2_INTR_SOURCE IRQ_DEFAULT_PRIORITY 0>;
		interrupt-parent = <&intc>;
		dma-enabled;
		dma-host = <0>; /* GDMA slot for SPI2 */
		dmas = <&dma 0>, <&dma 1>;
		dma-names = "tx", "rx";
		duplex = "MSPI_HALF_DUPLEX";

		clock-frequency = <80000000>;

		pinctrl-0 = <&mspi2_default>;
		pinctrl-names = "default";
		ce-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;

		// CO5300 display as MSPI device
		co5300_display: co5300-display@0 {
			compatible = "chipone,elco5300";
			reg = <0>;
			status = "okay";
			/* Should be less than or equal to CONFIG_MSPI_DMA_MAX_BUFFER_SIZE */
            max-buf-size = <10240>;

			// MSPI device properties
			mspi-max-frequency = <40000000>;

			// Display-specific GPIOs
			te-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;  // TE pin
			reset-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>; // Reset pin

			// Display properties
			// pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
            pixel-format = <PANEL_PIXEL_FORMAT_L_8>;
			width = <466>;
			height = <466>;
            x-offset = <6>;
			write-only;
		};
	};

	/* Touch Controller */
	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&cst92xx>;
	};
};

&dma {
	status = "okay";
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&i2c1 {
	status ="okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";

	/* Hynitron CST92XX Capacitive Touch Controller */
	cst92xx: cst92xx@5A {
		status = "okay";
		compatible = "hynitron,cst92xx";
		reg = <0x5A>;
		irq-gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		rst-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
		inverted-x;
		inverted-y;
	};

    tca9554: tca9554@20 {
        compatible = "nxp,pca9554";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <8>;
    };
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&spi3 {
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim3_default>;
	pinctrl-names = "default";

	spi_sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        status = "okay";
        spi-max-frequency = <24000000>;

        mmc {
            compatible = "zephyr,sdmmc-disk";
            disk-name = "SD";
            status = "okay";
        };
    };
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
