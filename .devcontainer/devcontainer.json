{
  "name": "rt_gauge (Zephyr Dev)",
  "dockerComposeFile": "compose.yaml",
  "service": "zephyr-dev",
  "workspaceFolder": "/home/ubuntu/zephyr/workspace/project",
  "remoteUser": "ubuntu",

  "forwardPorts": [5900],
  "portsAttributes": {
    "5900": {
      "label": "VNC (x11vnc)"
    }
  },

  // The image only activates the west/cmake/zcbor Python venv via .bashrc,
  // which non-interactive shells (e.g. tasks) don't source. Put it on PATH
  // explicitly so `west`, `cmake`, etc. resolve everywhere.
  "remoteEnv": {
    "PATH": "/home/ubuntu/zephyr/.venv/bin:${containerEnv:PATH}"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "cmake.sourceDirectory": "./app",
        "python.defaultInterpreterPath": "/home/ubuntu/zephyr/.venv/bin/python3",
        "C_Cpp.formatting": "clangFormat",
        "C_Cpp.clang_format_path": "/home/ubuntu/zephyr/.venv/bin/clang-format",
        "C_Cpp.codeAnalysis.clangTidy.enabled": true,
        "C_Cpp.codeAnalysis.clangTidy.path": "/usr/bin/clang-tidy-23"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "marus25.cortex-debug",
        "ms-python.python",
        "nordic-semiconductor.nrf-devicetree",
        "actboy168.tasks"
      ]
    }
  }
}
