// ESP32-S3 Reference Manual:
// https://www.espressif.com/sites/default/files/documentation/esp32-s3_technical_reference_manual_en.pdf

/ {
    aliases {
        intfs0 = &intfs0;
        gpioc = &gpioc;
        can0 = &can0;
    };

    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
		zephyr,entropy = &trng0;
    };

    fstab {
        compatible = "zephyr,fstab";

        intfs0: intfs0 {
            compatible = "zephyr,fstab,littlefs";
            read-size = <16>;
			prog-size = <256>;
			cache-size = <256>;
			lookahead-size = <32>;
            block-cycles = <512>;
            partition = <&intfs0_partition>;
            mount-point = "/intfs0";
            automount;
        };
    };

    gpioc: gpioc {
		compatible = "gpio-keys";

		di_0: di_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <INPUT_BTN_0>;
		};
	};
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Delete the overlapping partitions */
        /delete-node/ partition@5f0000;  /* slot1_partition - OVERLAPS with your partition */
        /delete-node/ partition@bc0000;  /* slot0_appcpu_partition - OVERLAPS */
        /delete-node/ partition@db0000;  /* slot1_appcpu_partition - OVERLAPS */
        /delete-node/ partition@fa0000;  /* slot0_lpcore_partition - OVERLAPS */
        /delete-node/ partition@fa8000;  /* slot1_lpcore_partition - OVERLAPS */
        // /delete-node/ partition@fff000;  /* stock coredump_partition - only 4KB, too small for a full RAM dump; replaced below */

        /* Your LittleFS partition */
        intfs0_partition: partition@600000 {
            label = "intfs0_storage";
            reg = <0x600000 DT_SIZE_M(8)>; // 8MB at offset 6MB
        };

        // /* Coredump storage (CONFIG_DEBUG_COREDUMP_BACKEND_FLASH_PARTITION).
        //  * 1MB, placed right after intfs0 (ends 0xe00000) and well clear of
        //  * storage_partition (0xfb0000, NVS/BT settings) and scratch_partition
        //  * (0xfe0000, mcuboot swap) - neither is touched.
        //  * Node label must stay "coredump_partition": the flash-partition
        //  * coredump backend binds to that exact DT node label via
        //  * DT_NODELABEL() (zephyr/subsys/debug/coredump/
        //  * coredump_backend_flash_partition.c), not a devicetree alias,
        //  * despite the Kconfig help text wording.
        //  */
        // coredump_partition: partition@e00000 {
        //     label = "coredump-partition";
        //     reg = <0xe00000 DT_SIZE_M(1)>;
        // };
    };
};

&usb_serial {
    status = "okay";
};

&spi3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim3_canbus>;
	pinctrl-names = "default";

	can0: mcp2518fd@0 {
		compatible = "microchip,mcp251xfd";
		reg = <0>;
		status = "okay";

		// MCP2518FD maximum SPI frequency is 20 MHz
		// But current temp setup is not stable at frequencies above 8 MHz
		// TODO: Investigate
		spi-max-frequency = <8000000>;
		int-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
		osc-freq = <20000000>;
	};

	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&pinctrl {
    spim3_canbus: spim3_canbus {
		group1 {
			pinmux = <SPIM3_MISO_GPIO17>,
				     <SPIM3_SCLK_GPIO44>,
				     <SPIM3_CSEL_GPIO18>;
		};
		group2 {
			pinmux = <SPIM3_MOSI_GPIO16>;
			output-low;
		};
	};
};
