diff --git a/drivers/misc/esp_hosted_mcu/Kconfig b/drivers/misc/esp_hosted_mcu/Kconfig
index 5cd7f318aef..2da01a7df9b 100644
--- a/drivers/misc/esp_hosted_mcu/Kconfig
+++ b/drivers/misc/esp_hosted_mcu/Kconfig
@@ -50,6 +50,17 @@ config ESP_HOSTED_MCU_RESET_PULSE_MS
 	help
 	  How long the reset line is held asserted to restart the coprocessor.
 
+config ESP_HOSTED_MCU_RPC_TIMEOUT_MS
+	int "RPC round-trip timeout (ms)"
+	default 5000
+	range 50 30000
+	help
+	  How long a request waits for the coprocessor to answer. A coprocessor
+	  running firmware this host cannot talk to leaves every call unanswered,
+	  and the first of them is made from POST_KERNEL init, so this is what
+	  the whole boot waits on before the application ever starts. Lower it on
+	  a board that has to tolerate a coprocessor it cannot use.
+
 config ESP_HOSTED_MCU_SPI_RESET_SETTLE_MS
 	int "Delay after reset (ms)"
 	depends on ESP_HOSTED_MCU_SPI
diff --git a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h
index 30a0be7e540..d8389ef63d4 100644
--- a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h
+++ b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h
@@ -165,7 +165,7 @@ struct esp_hosted_mcu_tlv {
 } __packed;
 
 /* RPC request/response round-trip and scan completion timeouts (ms). */
-#define ESP_HOSTED_MCU_RPC_TIMEOUT  (5000)
+#define ESP_HOSTED_MCU_RPC_TIMEOUT  (CONFIG_ESP_HOSTED_MCU_RPC_TIMEOUT_MS)
 #define ESP_HOSTED_MCU_SCAN_TIMEOUT (10000)
 
 /* How long to wait for the coprocessor's boot event before asking over RPC (ms). */
