+    int64_t xin0 = -(int64_t)tr_dsc.pivot.x;
+    int64_t yin0 = -(int64_t)tr_dsc.pivot.y;
+    map->x0_ups = (int32_t)transform_div((cosma * xin0 - sinma * yin0) * 64, tr_dsc.scale_x) + tr_dsc.pivot_x_256 + 0x80;
