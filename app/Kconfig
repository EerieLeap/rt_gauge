menu "Zephyr"

	# Keep the application priority only when the flush thread is enabled.
	configdefault LV_Z_FLUSH_THREAD_PRIORITY
		default 7

source "Kconfig.zephyr"

	config EERIE_LEAP_UI_RENDERER_THREAD_STACK_SIZE
		int "UI renderer thread stack size"
		default 8192

	config EERIE_LEAP_UI_RENDER_WORK_QUEUE_STACK_SIZE
		int "UI render work queue stack size"
		default 8192

	config EERIE_LEAP_UI_DEMO_CONFIGURATION
		bool "Install the demo UI configuration and assets"
		default y
		help
		  Installs the built-in demo screens, and the images and the animation they
		  show, when the unit stores no UI configuration. A stored configuration is
		  never replaced, and the demo assets only fill in files that are missing.
		  Turn it off in a release, where a unit without a configuration shows
		  nothing until a client stores one.

	config EERIE_LEAP_UI_PREVIEW
		bool "UI preview over SMP"
		default y
		depends on EERIE_LEAP_SMP
		# SHOW's target is a map inside the request's map; PATCH's ops are lists inside a list inside it.
		select MCUMGR_SMP_CBOR_MIN_DECODING_LEVEL_4
		help
		  Serves the SMP ui group (73): a client stages a UI configuration, which the unit
		  shows without storing it, and the stored one comes back when the session ends.
		  Without it the group is not registered and MCUmgr answers rc 8.

	config EERIE_LEAP_UI_PREVIEW_LEASE_MS
		int "UI preview lease"
		default 5000
		range 500 600000
		depends on EERIE_LEAP_UI_PREVIEW
		help
		  A preview ends, and the stored UI comes back, this long after the last request that
		  carried its token.

	config EERIE_LEAP_UI_PREVIEW_MAX_STAGE_SIZE
		int "Largest staged UI configuration"
		default 65536
		range 1024 65536
		depends on EERIE_LEAP_UI_PREVIEW
		help
		  The buffer a session allocates in external RAM when it begins, in bytes. 65536 is
		  the largest UI configuration a unit stores.

	config EERIE_LEAP_UI_IMAGE_MAX_SIZE
		int "Largest image upload"
		default 4194304
		help
		  Largest image a client may upload, in bytes.

	config EERIE_LEAP_UI_ANIMATION_MAX_SIZE
		int "Largest animation upload"
		default 524288
		help
		  Largest animation a client may upload, in bytes.

	config EERIE_LEAP_UI_FONT_MAX_SIZE
		int "Largest font upload"
		default 262144
		help
		  Largest font a client may upload, in bytes.

	config EERIE_LEAP_UI_FONT_GLYPH_CACHE_SIZE
		int "Glyph cache of one font size"
		default 131072
		help
		  Bytes of rasterized glyphs one font at one size may cache in the LVGL heap. The cache never holds fewer
		  than 16 glyphs, so sizes above about 128 px can use more.

	choice EERIE_LEAP_UI_ROTATION_CHOICE
		prompt "UI rotation"
		default EERIE_LEAP_UI_ROTATION_NONE
		help
		  Rotation applied to the LVGL display. LVGL's software renderer
		  cannot rotate, so anything other than none replaces the flush
		  callback with one that rotates each rendered area on its way to the
		  panel, and needs LV_Z_FLUSH_THREAD disabled because that thread
		  drives the callback being replaced.

		config EERIE_LEAP_UI_ROTATION_NONE
			bool "No rotation"
		config EERIE_LEAP_UI_ROTATION_90
			bool "Rotated 90 degrees"
		config EERIE_LEAP_UI_ROTATION_180
			bool "Rotated 180 degrees"
		config EERIE_LEAP_UI_ROTATION_270
			bool "Rotated 270 degrees"
	endchoice

	config EERIE_LEAP_UI_ROTATION
		int
		default 0 if EERIE_LEAP_UI_ROTATION_NONE
		default 90 if EERIE_LEAP_UI_ROTATION_90
		default 180 if EERIE_LEAP_UI_ROTATION_180
		default 270 if EERIE_LEAP_UI_ROTATION_270

	config EERIE_LEAP_FLOAT_SIGNIFICANT_DIGITS
		int "Floating point significant digits"
		default 4

endmenu

module = APP
module-str = APP
