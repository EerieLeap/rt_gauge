config WAVESHARE_HX8394
	bool "Waveshare HX8394 MIPI DSI panel"
	default y
	depends on DT_HAS_WAVESHARE_HX8394_ENABLED
	depends on MIPI_DSI
	select PWM
	help
	  Enable support for the HX8394 driving the Waveshare 5" 720x1280
	  MIPI DSI module. PWM is what the panel is dimmed from, the
	  controller having no brightness command of its own.
