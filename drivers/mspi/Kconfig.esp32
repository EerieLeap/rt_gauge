config MSPI_ESP32
	bool "ESP32 MSPI driver"
	depends on DT_HAS_ESPRESSIF_ESP32_MSPI_ENABLED
	help
	  Enable ESP32 MSPI driver. This driver provides support for the
	  ESP32 SPI peripherals through the Zephyr MSPI interface.

if MSPI_ESP32

config MSPI_DMA_MAX_BUFFER_SIZE
	int "MSPI DMA bounce buffer size (Byte)"
	default 4092
	help
	  Size of the driver's bounce buffer, and nothing else. Data the DMA
	  can reach (4-byte aligned internal RAM) is sent straight from the
	  caller's buffer, in hardware transactions of up to 32,768 bytes
	  (2^18 bits, or what the GDMA descriptor table holds if smaller). Data
	  it cannot reach, such as PSRAM, is copied through the bounce buffer
	  and sent in pieces of this many bytes (at most one hardware
	  transaction). A packet longer than one transaction is split by the
	  driver with CE held, and the command and address go out with the
	  first piece only; callers need not chunk. Transfers of at most 64
	  bytes go through the SPI data registers and never use the buffer.

config MSPI_ESP32_INTERRUPT
	bool "ESP32 MSPI interrupt mode"
	default y
	help
	  Signal transfer completion using the SPI "transaction done"
	  interrupt instead of busy-polling the hardware from the calling
	  thread. This lets other threads run while a transfer is in
	  flight, instead of spinning the calling thread's CPU for the full
	  duration of every transfer. Requires an "interrupts" property on
	  the MSPI controller's devicetree node.

config MSPI_ESP32_PSRAM_DMA
	bool "Transfer directly out of PSRAM buffers"
	depends on ESP_SPIRAM
	help
	  Hand cache-line aligned PSRAM buffers straight to the DMA instead of
	  copying them into internal RAM first.

	  This removes the copy, but the DMA must then feed the transmit FIFO
	  straight from PSRAM at the full bus rate. PSRAM bandwidth is shared
	  with instruction fetch and any other external-RAM traffic, so when it
	  cannot keep up the FIFO underruns and the transfer is silently
	  corrupted. The intermediate copy otherwise decouples the two rates.

	  Only enable this if the bus clock is low enough that PSRAM can sustain
	  it, and verify the resulting data.

config MSPI_ESP32_STATS
	bool "ESP32 MSPI bench counters"
	depends on SHELL
	help
	  Bench counters read by the app's ui_bench shell command; adds a few
	  cycles per transaction.

endif # MSPI_ESP32
